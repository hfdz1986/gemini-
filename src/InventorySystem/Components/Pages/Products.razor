@page "/products"
@rendermode InteractiveServer
@inject ProductService Service
@inject CategoryService Categories

<PageTitle>商品</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h1>商品</h1>
    <button class="btn btn-primary" @onclick="() => Edit(new())"><i class="bi bi-plus-lg"></i> 新增商品</button>
</div>

<div class="card-surface mt-3">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>编码</th><th>名称</th><th>分类</th><th>单位</th>
                <th class="text-end">进价</th><th class="text-end">售价</th>
                <th class="text-end">库存</th><th>状态</th><th style="width:140px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in _items)
            {
                <tr>
                    <td>@p.Code</td>
                    <td>@p.Name</td>
                    <td>@p.Category?.Name</td>
                    <td>@p.Unit</td>
                    <td class="text-end">@p.PurchasePrice.ToString("N2")</td>
                    <td class="text-end">@p.SalePrice.ToString("N2")</td>
                    <td class="text-end @(p.SafetyStock > 0 && p.StockQuantity <= p.SafetyStock ? "text-danger fw-bold" : "")">@p.StockQuantity</td>
                    <td>
                        @if (p.IsActive)
                        { <span class="badge bg-success">启用</span> }
                        else
                        { <span class="badge bg-secondary">停用</span> }
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(p)"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(p)"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            }
            @if (_items.Count == 0)
            {
                <tr><td colspan="9" class="text-center text-muted py-4">暂无数据</td></tr>
            }
        </tbody>
    </table>
</div>

@if (_editing is not null)
{
    <div class="modal-backdrop-custom">
        <div class="card-surface" style="width:520px">
            <h5>@(_editing.Id == 0 ? "新增" : "编辑")商品</h5>
            <EditForm Model="_editing" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <div class="row">
                    <div class="col mb-2">
                        <label class="form-label">编码 *</label>
                        <InputText class="form-control" @bind-Value="_editing.Code" />
                        <ValidationMessage For="() => _editing.Code" class="text-danger small" />
                    </div>
                    <div class="col mb-2">
                        <label class="form-label">名称 *</label>
                        <InputText class="form-control" @bind-Value="_editing.Name" />
                        <ValidationMessage For="() => _editing.Name" class="text-danger small" />
                    </div>
                </div>
                <div class="row">
                    <div class="col mb-2">
                        <label class="form-label">分类</label>
                        <InputSelect class="form-select" @bind-Value="_editing.CategoryId">
                            <option value="">（未分类）</option>
                            @foreach (var c in _categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col mb-2">
                        <label class="form-label">单位</label>
                        <InputText class="form-control" @bind-Value="_editing.Unit" />
                    </div>
                </div>
                <div class="row">
                    <div class="col mb-2">
                        <label class="form-label">进价</label>
                        <InputNumber class="form-control" @bind-Value="_editing.PurchasePrice" />
                    </div>
                    <div class="col mb-2">
                        <label class="form-label">售价</label>
                        <InputNumber class="form-control" @bind-Value="_editing.SalePrice" />
                    </div>
                    <div class="col mb-2">
                        <label class="form-label">安全库存</label>
                        <InputNumber class="form-control" @bind-Value="_editing.SafetyStock" />
                    </div>
                </div>
                @if (_editing.Id == 0)
                {
                    <div class="mb-2">
                        <label class="form-label">期初库存</label>
                        <InputNumber class="form-control" @bind-Value="_editing.StockQuantity" />
                        <div class="form-text">仅新建时设置初始数量；之后库存由采购/销售单维护。</div>
                    </div>
                }
                else
                {
                    <div class="alert alert-light py-2 small mb-2">当前库存 <b>@_editing.StockQuantity</b>，请通过采购/销售单调整。</div>
                }
                <div class="mb-2">
                    <label class="form-label">备注</label>
                    <InputText class="form-control" @bind-Value="_editing.Remark" />
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" id="active" @bind-Value="_editing.IsActive" />
                    <label class="form-check-label" for="active">启用</label>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-light" @onclick="() => _editing = null">取消</button>
                    <button type="submit" class="btn btn-primary">保存</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<Product> _items = new();
    private List<Category> _categories = new();
    private Product? _editing;

    protected override async Task OnInitializedAsync()
    {
        _categories = await Categories.GetAllAsync();
        await Load();
    }

    private async Task Load() => _items = await Service.GetAllAsync();

    private void Edit(Product p) => _editing = new Product
    {
        Id = p.Id, Code = p.Code, Name = p.Name, CategoryId = p.CategoryId,
        Unit = p.Unit, PurchasePrice = p.PurchasePrice, SalePrice = p.SalePrice,
        StockQuantity = p.StockQuantity, SafetyStock = p.SafetyStock,
        IsActive = p.IsActive, Remark = p.Remark
    };

    private async Task Save()
    {
        await Service.SaveAsync(_editing!);
        _editing = null;
        await Load();
    }

    private async Task Delete(Product p)
    {
        await Service.DeleteAsync(p.Id);
        await Load();
    }
}
